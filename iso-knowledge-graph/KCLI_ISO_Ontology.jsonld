{"@context":{"kg":"urn:kcli:iso-kg:","rdfs":"http://www.w3.org/2000/01/rdf-schema#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","owl":"http://www.w3.org/2002/07/owl#","skos":"http://www.w3.org/2004/02/skos/core#","dct":"http://purl.org/dc/terms/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@id":"kg:ontology","@type":"owl:Ontology","rdfs:label":{"@value":"KCLI ISO 규격·용어 온톨로지","@language":"ko"},"dct:date":{"@value":"2026-11-20","@type":"xsd:date"},"rdfs:comment":{"@value":"교육용 선별 모델. 규격의 적용 범위, 판본별 조항, 교육용 관계와 가상 사례를 구분한다.","@language":"ko"}},{"@id":"kg:Standard","@type":"owl:Class","rdfs:label":{"@value":"규격","@language":"ko"},"rdfs:comment":{"@value":"연도와 발행 주체로 식별한 규격 판본입니다.","@language":"ko"}},{"@id":"kg:Clause","@type":"owl:Class","rdfs:label":{"@value":"조항","@language":"ko"},"rdfs:comment":{"@value":"특정 판본에 속하는 조항입니다.","@language":"ko"}},{"@id":"kg:Term","@type":"owl:Class","rdfs:label":{"@value":"용어","@language":"ko"},"rdfs:comment":{"@value":"정의와 한·영 명칭이 있는 개념입니다.","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"kg:Example","@type":"owl:Class","rdfs:label":{"@value":"실무 예시","@language":"ko"},"rdfs:comment":{"@value":"개념을 설명하기 위해 구성한 가상의 실무 상황입니다.","@language":"ko"}},{"@id":"kg:hasClause","@type":"owl:ObjectProperty","rdfs:label":{"@value":"조항 포함","@language":"ko"},"rdfs:domain":{"@id":"kg:Standard"},"rdfs:range":{"@id":"kg:Clause"},"rdfs:comment":{"@value":"해당 판본에 수록된 조항을 가리킵니다.","@language":"ko"}},{"@id":"kg:specifies","@type":"owl:ObjectProperty","rdfs:label":{"@value":"요구사항 제시","@language":"ko"},"rdfs:domain":{"@id":"kg:Standard"},"rdfs:range":{"@id":"kg:Term"},"rdfs:comment":{"@value":"해당 경영시스템 또는 인증기관에 적용하는 요구사항을 제시합니다.","@language":"ko"}},{"@id":"kg:vocabulary","@type":"owl:ObjectProperty","rdfs:label":{"@value":"용어 설명","@language":"ko"},"rdfs:domain":{"@id":"kg:Standard"},"rdfs:range":{"@id":"kg:Term"},"rdfs:comment":{"@value":"기본 개념이나 용어의 의미를 설명합니다.","@language":"ko"}},{"@id":"kg:guides","@type":"owl:ObjectPropert