://roknnaoms-hub.github.io/kcli-homepage/#iso-19011-clauses","dct:title":{"@value":"KCLI · ISO 19011 조항 목록","@language":"ko"}},{"@id":"https://www.iso.org/standard/61651.html","dct:title":{"@value":"ISO/IEC 17021-1:2015 · ISO 공식 목록","@language":"ko"}},{"@id":"kg:s9001","@type":"kg:Standard","rdfs:label":{"@value":"ISO 9001:2026","@language":"ko"},"rdfs:comment":{"@value":"고객 요구와 적용되는 요구사항을 일관되게 충족하도록 조직이 품질을 관리하고 개선하는 방법을 규정합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"}],"skos:altLabel":[{"@value":"Quality management systems","@language":"en"}],"dct:title":{"@value":"품질경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:qms"}],"kg:basedOn":[{"@id":"kg:s9000"}],"kg:hasClause":[{"@id":"kg:q92"},{"@id":"kg:q102"}]},{"@id":"kg:s14001","@type":"kg:Standard","rdfs:label":{"@value":"ISO 14001:2026","@language":"ko"},"rdfs:comment":{"@value":"조직의 활동이 환경과 어떻게 상호작용하는지 파악하고 환경성과를 개선하기 위한 경영시스템의 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"}],"skos:altLabel":[{"@value":"Environmental management systems","@language":"en"}],"dct:title":{"@value":"환경경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:ems"}],"kg:hasClause":[{"@id":"kg:e612"}]},{"@id":"kg:s45001","@type":"kg:Standard","rdfs:label":{"@value":"ISO 45001:2018","@language":"ko"},"rdfs:comment":{"@value":"근로자가 참여하여 유해·위험요인을 발견하고 업무로 인한 부상과 건강 장해를 예방하도록 안전보건경영시스템의 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"}],"skos:altLabel":[{"@value":"Occupational health and safety management systems","@language":"en"}],"dct:title":{"@value":"안전보건경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:amendmentNote":{"@value":"Amd 1:2024 · 기후변화 관련 추가사항","@language":"ko"},"kg:specifies":[{"@id":"kg:ohs"}],"kg:hasClause":[{"@id":"kg:h54"},{"@id":"kg:h6121"}]},{"@id":"kg:s22301","@type":"kg:Standard","rdfs:label":{"@value":"ISO 22301:2019","@language":"ko"},"rdfs:comment":{"@value":"중단 상황에서도 우선 업무를 계속하고 회복할 수 있도록 업무연속성경영시스템의 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/75106.html"}],"skos:altLabel":[{"@value":"Business continuity management systems","@language":"en"}],"dct:title":{"@value":"업무연속성경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:amendmentNote":{"@value":"Amd 1:2024 · 기후변화 관련 추가사항","@language":"ko"},"kg:specifies":[{"@id":"kg:bcms"}],"kg:hasClause":[{"@id":"kg:b822"}]},{"@id":"kg:s27001","@type":"kg:Standard","rdfs:label":{"@value":"ISO/IEC 27001:2022","@language":"ko"},"rdfs:comment":{"@value":"조직이 정보보호 리스크를 평가하고 처리하며 정보보호경영시스템을 유지·개선하는 데 필요한 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27001"}],"skos:altLabel":[{"@value":"Information security management systems","@language":"en"}],"dct:title":{"@value":"정보보호경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:amendmentNote":{"@value":"Amd 1:2024 · 기후변화 관련 추가사항","@language":"ko"},"kg:specifies":[{"@id":"kg:isms"}],"kg:hasClause":[{"@id":"kg:i612"}]},{"@id":"kg:s27701","@type":"kg:Standard","rdfs:label":{"@value":"ISO/IEC 27701:2025","@language":"ko"},"rdfs:comment":{"@value":"개인식별정보 처리에 책임이 있는 조직이 개인정보보호경영시스템을 수립하고 운영하는 데 필요한 요구사항과 지침을 제공합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"}],"skos:altLabel":[{"@value":"Privacy information management systems","@language":"en"}],"dct:title":{"@value":"개인정보보호경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:pims"}],"kg:hasClause":[{"@id":"kg:p612"}]},{"@id":"kg:s42001","@type":"kg:Standard","rdfs:label":{"@value":"ISO/IEC 42001:2023","@language":"ko"},"rdfs:comment":{"@value":"AI 제품이나 서비스를 제공하거나 사용하는 조직이 AI 관련 책임과 리스크를 관리하는 데 필요한 경영시스템 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"}],"skos:altLabel":[{"@value":"Artificial intelligence management system","@language":"en"}],"dct:title":{"@value":"인공지능경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:aims"}],"kg:hasClause":[{"@id":"kg:a614"},{"@id":"kg:a84"}]},{"@id":"kg:s53001","@type":"kg:Standard","rdfs:label":{"@value":"ISO/UNDP 53001:2026","@language":"ko"},"rdfs:comment":{"@value":"조직의 의사결정과 활동이 유엔 지속가능발전목표에 미치는 영향을 파악하고 긍정적 기여를 높이기 위한 경영시스템 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"}],"skos:altLabel":[{"@value":"Management systems for the UN Sustainable Development Goals","@language":"en"}],"dct:title":{"@value":"지속가능발전목표 경영시스템","@language":"ko"},"kg:role":{"@value":"경영시스템 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:sdgms"}],"kg:hasClause":[{"@id":"kg:d622"}]},{"@id":"kg:s9000","@type":"kg:Standard","rdfs:label":{"@value":"ISO 9000:2026","@language":"ko"},"rdfs:comment":{"@value":"품질경영 원칙과 용어를 설명합니다. ISO 9001의 요구사항을 일관되게 해석하는 기초가 됩니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"}],"skos:altLabel":[{"@value":"Quality management fundamentals and vocabulary","@language":"en"}],"dct:title":{"@value":"품질경영 기본 개념과 용어","@language":"ko"},"kg:role":{"@value":"기본 개념·용어","@language":"ko"},"kg:vocabulary":[{"@id":"kg:ms"},{"@id":"kg:req"},{"@id":"kg:conform"},{"@id":"kg:nc"},{"@id":"kg:correction"},{"@id":"kg:ca"},{"@id":"kg:process"},{"@id":"kg:party"}]},{"@id":"kg:s19011","@type":"kg:Standard","rdfs:label":{"@value":"ISO 19011:2026","@language":"ko"},"rdfs:comment":{"@value":"조직이 심사 프로그램을 운영하고 개별 심사를 수행하며 심사원의 역량을 평가하는 방법을 안내합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"}],"skos:altLabel":[{"@value":"Guidelines for auditing management systems","@language":"en"}],"dct:title":{"@value":"경영시스템 심사 지침","@language":"ko"},"kg:role":{"@value":"심사 지침","@language":"ko"},"kg:guides":[{"@id":"kg:criteria"},{"@id":"kg:evidence"},{"@id":"kg:audit"},{"@id":"kg:auditor"},{"@id":"kg:programme"},{"@id":"kg:finding"}]},{"@id":"kg:s17021","@type":"kg:Standard","rdfs:label":{"@value":"ISO/IEC 17021-1:2015","@language":"ko"},"rdfs:comment":{"@value":"경영시스템 심사와 인증을 제공하는 기관이 갖춰야 할 역량, 공평성 및 일관된 운영에 관한 요구사항을 제시합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/61651.html"}],"skos:altLabel":[{"@value":"Requirements for management system certification bodies","@language":"en"}],"dct:title":{"@value":"경영시스템 인증기관 요구사항","@language":"ko"},"kg:role":{"@value":"인증기관 요구사항","@language":"ko"},"kg:specifies":[{"@id":"kg:cb"}]},{"@id":"kg:ms","@type":"kg:Term","rdfs:label":{"@value":"경영시스템","@language":"ko"},"rdfs:comment":{"@value":"목표를 정하고 달성할 수 있도록 조직의 방침, 책임, 자원과 프로세스를 함께 운영하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"}],"skos:altLabel":[{"@value":"Management system","@language":"en"}]},{"@id":"kg:qms","@type":"kg:Term","rdfs:label":{"@value":"품질경영시스템","@language":"ko"},"rdfs:comment":{"@value":"제품과 서비스가 요구사항을 충족하도록 조직의 프로세스와 책임을 관리하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"}],"skos:altLabel":[{"@value":"Quality management system","@language":"en"},{"@value":"QMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:process"}]},{"@id":"kg:ems","@type":"kg:Term","rdfs:label":{"@value":"환경경영시스템","@language":"ko"},"rdfs:comment":{"@value":"환경측면과 준수의무를 관리하고 조직의 환경성과를 개선하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"}],"skos:altLabel":[{"@value":"Environmental management system","@language":"en"},{"@value":"EMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:aspect"}]},{"@id":"kg:ohs","@type":"kg:Term","rdfs:label":{"@value":"안전보건경영시스템","@language":"ko"},"rdfs:comment":{"@value":"일터의 위험을 관리하고 근로자 참여를 통해 안전하고 건강한 근무 여건을 조성하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"}],"skos:altLabel":[{"@value":"Occupational health and safety management system","@language":"en"},{"@value":"OH&S MS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:hazard"},{"@id":"kg:participate"}]},{"@id":"kg:bcms","@type":"kg:Term","rdfs:label":{"@value":"업무연속성경영시스템","@language":"ko"},"rdfs:comment":{"@value":"업무 중단에 대비하여 대응·복구 능력을 계획하고 연습하며 개선하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/75106.html"}],"skos:altLabel":[{"@value":"Business continuity management system","@language":"en"},{"@value":"BCMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:bia"}]},{"@id":"kg:isms","@type":"kg:Term","rdfs:label":{"@value":"정보보호경영시스템","@language":"ko"},"rdfs:comment":{"@value":"정보 자산과 그 이용 과정의 리스크를 관리해 기밀성·무결성·가용성을 보호하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27001"}],"skos:altLabel":[{"@value":"Information security management system","@language":"en"},{"@value":"ISMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:isrisk"},{"@id":"kg:pims"}]},{"@id":"kg:pims","@type":"kg:Term","rdfs:label":{"@value":"개인정보보호경영시스템","@language":"ko"},"rdfs:comment":{"@value":"개인식별정보 처리에 따르는 책임과 리스크를 관리하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"}],"skos:altLabel":[{"@value":"Privacy information management system","@language":"en"},{"@value":"PIMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:pii"},{"@id":"kg:privrisk"}]},{"@id":"kg:aims","@type":"kg:Term","rdfs:label":{"@value":"인공지능경영시스템","@language":"ko"},"rdfs:comment":{"@value":"AI 시스템을 개발·제공·이용하는 조직이 방침, 역할, 평가 및 통제를 운영하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"}],"skos:altLabel":[{"@value":"Artificial intelligence management system","@language":"en"},{"@value":"AIMS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:aia"}]},{"@id":"kg:sdgms","@type":"kg:Term","rdfs:label":{"@value":"지속가능발전목표 경영시스템","@language":"ko"},"rdfs:comment":{"@value":"조직이 유엔 지속가능발전목표에 미치는 영향을 전략과 운영에 반영하고 성과를 점검하는 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"}],"skos:altLabel":[{"@value":"SDG management system","@language":"en"},{"@value":"SDG MS","@language":"en"}],"kg:isKindOf":[{"@id":"kg:ms"}],"kg:topic":[{"@id":"kg:sdg"},{"@id":"kg:priority"},{"@id":"kg:party"}]},{"@id":"kg:criteria","@type":"kg:Term","rdfs:label":{"@value":"심사기준","@language":"ko"},"rdfs:comment":{"@value":"심사에서 충족 여부를 판단할 때 증거와 대조하는 요구사항입니다. 적용 표준의 조항, 조직의 절차 또는 계약상 요건 등이 해당할 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Audit criteria","@language":"en"}],"kg:criterionFor":[{"@id":"kg:finding"}],"kg:topic":[{"@id":"kg:req"}],"kg:example":[{"@id":"kg:exCriteria"}]},{"@id":"kg:evidence","@type":"kg:Term","rdfs:label":{"@value":"심사증거","@language":"ko"},"rdfs:comment":{"@value":"심사기준과 관련이 있고 확인할 수 있는 정보입니다. 기록, 검증 가능한 진술, 현장 관찰 결과 등을 사용할 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Audit evidence","@language":"en"}],"kg:evidenceFor":[{"@id":"kg:finding"}],"kg:example":[{"@id":"kg:exEvidence"}]},{"@id":"kg:finding","@type":"kg:Term","rdfs:label":{"@value":"심사발견사항","@language":"ko"},"rdfs:comment":{"@value":"심사증거를 심사기준과 대조해 얻은 평가 결과입니다. 어떤 요구사항을 어떤 사실로 확인했는지를 함께 기록하면 판단 근거를 추적할 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Audit findings","@language":"en"}],"kg:mayIndicate":[{"@id":"kg:conform"},{"@id":"kg:nc"}],"kg:example":[{"@id":"kg:exFind"}]},{"@id":"kg:audit","@type":"kg:Term","rdfs:label":{"@value":"심사","@language":"ko"},"rdfs:comment":{"@value":"정해진 범위에서 증거를 체계적이고 독립적으로 수집·평가하여 심사기준의 충족 정도를 판단하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Audit","@language":"en"}],"kg:topic":[{"@id":"kg:criteria"},{"@id":"kg:evidence"}]},{"@id":"kg:auditor","@type":"kg:Term","rdfs:label":{"@value":"심사원","@language":"ko"},"rdfs:comment":{"@value":"심사를 수행하는 사람입니다. 담당 분야의 요구사항과 심사 방법을 적용해 증거를 수집하고 평가합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Auditor","@language":"en"}],"kg:topic":[{"@id":"kg:audit"}]},{"@id":"kg:internal","@type":"kg:Term","rdfs:label":{"@value":"내부심사","@language":"ko"},"rdfs:comment":{"@value":"조직 자체 또는 조직을 대신하는 사람이 조직의 경영시스템을 정해진 기준에 따라 심사하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Internal audit","@language":"en"}],"kg:isKindOf":[{"@id":"kg:audit"}]},{"@id":"kg:programme","@type":"kg:Term","rdfs:label":{"@value":"심사 프로그램","@language":"ko"},"rdfs:comment":{"@value":"일정 기간 동안 하나 이상의 심사를 어떤 목적으로 어떻게 운영할지 정한 계획과 운영 체계입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Audit programme","@language":"en"}],"kg:topic":[{"@id":"kg:audit"}]},{"@id":"kg:req","@type":"kg:Term","rdfs:label":{"@value":"요구사항","@language":"ko"},"rdfs:comment":{"@value":"제품·서비스·프로세스 또는 경영시스템이 충족해야 하는 필요나 기대입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Requirement","@language":"en"}]},{"@id":"kg:conform","@type":"kg:Term","rdfs:label":{"@value":"적합","@language":"ko"},"rdfs:comment":{"@value":"확인 대상이 적용되는 요구사항을 충족한 상태입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Conformity","@language":"en"}]},{"@id":"kg:nc","@type":"kg:Term","rdfs:label":{"@value":"부적합","@language":"ko"},"rdfs:comment":{"@value":"확인 대상이 적용되는 요구사항을 충족하지 못한 상태입니다. 어떤 요구사항을 충족하지 못했는지 특정할 수 있어야 합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Nonconformity","@language":"en"}],"kg:mayTrigger":[{"@id":"kg:correction"},{"@id":"kg:ca"}]},{"@id":"kg:correction","@type":"kg:Term","rdfs:label":{"@value":"시정","@language":"ko"},"rdfs:comment":{"@value":"발견한 부적합 자체를 바로잡는 조치입니다. 교육기록에 누락된 승인 내역을 확인하여 보완하는 것이 한 예입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Correction","@language":"en"}],"kg:example":[{"@id":"kg:exCorr"}]},{"@id":"kg:ca","@type":"kg:Term","rdfs:label":{"@value":"시정조치","@language":"ko"},"rdfs:comment":{"@value":"부적합의 원인을 제거하여 같은 문제가 다시 발생하지 않게 하는 조치입니다. 원인에 맞는 조치를 취하고 효과를 확인합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Corrective action","@language":"en"}],"kg:example":[{"@id":"kg:exCa"}]},{"@id":"kg:process","@type":"kg:Term","rdfs:label":{"@value":"프로세스","@language":"ko"},"rdfs:comment":{"@value":"입력을 받아 서로 연관된 활동으로 의도한 결과를 만들어 내는 과정입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Process","@language":"en"}]},{"@id":"kg:party","@type":"kg:Term","rdfs:label":{"@value":"이해관계자","@language":"ko"},"rdfs:comment":{"@value":"조직의 결정이나 활동에 영향을 주거나 받는 개인 또는 조직입니다. 영향을 받는다고 인식하는 경우도 포함합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}],"skos:altLabel":[{"@value":"Interested party","@language":"en"}]},{"@id":"kg:aspect","@type":"kg:Term","rdfs:label":{"@value":"환경측면","@language":"ko"},"rdfs:comment":{"@value":"조직의 활동·제품·서비스 중 환경과 상호작용하는 요소입니다. 세척 공정에서 물을 사용하는 행위가 한 예입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-14001-clauses"}],"skos:altLabel":[{"@value":"Environmental aspect","@language":"en"}],"kg:mayCause":[{"@id":"kg:impact"}],"kg:example":[{"@id":"kg:exEnv"}]},{"@id":"kg:impact","@type":"kg:Term","rdfs:label":{"@value":"환경영향","@language":"ko"},"rdfs:comment":{"@value":"환경측면 때문에 환경에 생기는 변화입니다. 수자원 이용 가능성의 변화처럼 유익하거나 불리하게 나타날 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-14001-clauses"}],"skos:altLabel":[{"@value":"Environmental impact","@language":"en"}]},{"@id":"kg:hazard","@type":"kg:Term","rdfs:label":{"@value":"유해·위험요인","@language":"ko"},"rdfs:comment":{"@value":"부상이나 건강 장해를 일으킬 잠재성이 있는 원천입니다. 예를 들어 통로에 남은 세척수는 미끄러짐의 원천이 될 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-45001-clauses"}],"skos:altLabel":[{"@value":"Hazard","@language":"en"}],"kg:example":[{"@id":"kg:exHealth"}]},{"@id":"kg:participate","@type":"kg:Term","rdfs:label":{"@value":"근로자 참여","@language":"ko"},"rdfs:comment":{"@value":"근로자가 일터의 안전보건에 관한 의사결정에 관여하는 것입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-45001-clauses"}],"skos:altLabel":[{"@value":"Participation of workers","@language":"en"}]},{"@id":"kg:bia","@type":"kg:Term","rdfs:label":{"@value":"업무영향분석","@language":"ko"},"rdfs:comment":{"@value":"업무가 중단된 시간이 길어질 때 영향이 어떻게 커지는지 분석하여 복구 우선순위와 필요한 자원을 정하는 데 활용합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/75106.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-22301-clauses"}],"skos:altLabel":[{"@value":"Business impact analysis","@language":"en"},{"@value":"BIA","@language":"en"}],"kg:example":[{"@id":"kg:exBia"}]},{"@id":"kg:isrisk","@type":"kg:Term","rdfs:label":{"@value":"정보보호 리스크 평가","@language":"ko"},"rdfs:comment":{"@value":"정보의 기밀성·무결성·가용성을 해칠 수 있는 상황을 식별하고 결과와 가능성을 분석해 대응 우선순위를 평가합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27001-clauses"}],"skos:altLabel":[{"@value":"Information security risk assessment","@language":"en"}],"kg:example":[{"@id":"kg:exSec"}]},{"@id":"kg:pii","@type":"kg:Term","rdfs:label":{"@value":"개인식별정보","@language":"ko"},"rdfs:comment":{"@value":"개인과 연결되거나 다른 정보와 결합해 특정 개인을 식별할 수 있는 정보입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"}],"skos:altLabel":[{"@value":"Personally identifiable information","@language":"en"},{"@value":"PII","@language":"en"}]},{"@id":"kg:privrisk","@type":"kg:Term","rdfs:label":{"@value":"개인정보보호 리스크 평가","@language":"ko"},"rdfs:comment":{"@value":"개인식별정보의 처리에서 발생할 수 있는 리스크를 파악하고 평가하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27701-clauses"}],"skos:altLabel":[{"@value":"Privacy risk assessment","@language":"en"}],"kg:example":[{"@id":"kg:exPrivacy"}]},{"@id":"kg:ai","@type":"kg:Term","rdfs:label":{"@value":"AI 시스템","@language":"ko"},"rdfs:comment":{"@value":"주어진 목표에 따라 입력을 처리해 예측·추천·결정 등의 출력을 만드는 시스템입니다. 조직이 평가하고 관리하는 기술적 대상입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#ai-management"}],"skos:altLabel":[{"@value":"AI system","@language":"en"}]},{"@id":"kg:aia","@type":"kg:Term","rdfs:label":{"@value":"AI 시스템 영향평가","@language":"ko"},"rdfs:comment":{"@value":"AI 시스템의 개발·제공·사용이 개인, 집단 또는 사회에 미칠 수 있는 결과를 파악하고 평가하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-42001-clauses"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#ai-management"}],"skos:altLabel":[{"@value":"AI system impact assessment","@language":"en"}],"kg:evaluates":[{"@id":"kg:ai"}],"kg:topic":[{"@id":"kg:party"}],"kg:example":[{"@id":"kg:exAi"}]},{"@id":"kg:sdg","@type":"kg:Term","rdfs:label":{"@value":"지속가능발전목표","@language":"ko"},"rdfs:comment":{"@value":"유엔의 17개 지속가능발전목표입니다. 조직은 자신의 활동과 관련된 영향을 고려하여 기여할 목표와 조치를 정할 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"}],"skos:altLabel":[{"@value":"Sustainable Development Goals","@language":"en"},{"@value":"SDGs","@language":"en"}]},{"@id":"kg:priority","@type":"kg:Term","rdfs:label":{"@value":"영향의 우선순위 결정","@language":"ko"},"rdfs:comment":{"@value":"조직이 파악한 긍정적·부정적 영향을 검토하여 우선적으로 다룰 대상을 정하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-53001-clauses"}],"skos:altLabel":[{"@value":"Impact prioritization","@language":"en"}],"kg:example":[{"@id":"kg:exSDG"}]},{"@id":"kg:cb","@type":"kg:Term","rdfs:label":{"@value":"인증기관","@language":"ko"},"rdfs:comment":{"@value":"조직의 경영시스템을 심사하고 인증 여부를 결정하는 제3자 기관입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/61651.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#certification-system"}],"skos:altLabel":[{"@value":"Certification body","@language":"en"}],"kg:topic":[{"@id":"kg:cert"}]},{"@id":"kg:cert","@type":"kg:Term","rdfs:label":{"@value":"경영시스템 인증","@language":"ko"},"rdfs:comment":{"@value":"독립적인 제3자가 조직의 경영시스템이 명시된 요구사항을 충족하는지 평가하고 이를 공식적으로 확인하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/61651.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#certification-system"}],"skos:altLabel":[{"@value":"Management system certification","@language":"en"}]},{"@id":"kg:third","@type":"kg:Term","rdfs:label":{"@value":"제3자 인증심사","@language":"ko"},"rdfs:comment":{"@value":"조직 외부의 독립된 인증기관이 인증 결정을 위해 조직의 경영시스템을 심사하는 활동입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/61651.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#certification-system"}],"skos:altLabel":[{"@value":"Third-party certification audit","@language":"en"}],"kg:isKindOf":[{"@id":"kg:audit"}],"kg:topic":[{"@id":"kg:cb"}]},{"@id":"kg:q92","@type":"kg:Clause","rdfs:label":{"@value":"9.2 내부심사","@language":"ko"},"rdfs:comment":{"@value":"계획한 내부심사를 통해 품질경영시스템이 관련 요구사항에 부합하고 효과적으로 운영되는지 확인하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-9001-clauses"}],"dct:identifier":"ISO 9001:2026 §9.2","kg:addresses":[{"@id":"kg:internal"}]},{"@id":"kg:q102","@type":"kg:Clause","rdfs:label":{"@value":"10.2 부적합 및 시정조치","@language":"ko"},"rdfs:comment":{"@value":"부적합에 대응하고 원인을 다룰 필요성을 평가하며 취한 시정조치의 효과를 검토하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-9001-clauses"}],"dct:identifier":"ISO 9001:2026 §10.2","kg:addresses":[{"@id":"kg:nc"},{"@id":"kg:correction"},{"@id":"kg:ca"}]},{"@id":"kg:e612","@type":"kg:Clause","rdfs:label":{"@value":"6.1.2 환경측면","@language":"ko"},"rdfs:comment":{"@value":"활동·제품·서비스의 환경측면과 관련 영향을 파악하고 중요성을 판단하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-14001-clauses"}],"dct:identifier":"ISO 14001:2026 §6.1.2","kg:addresses":[{"@id":"kg:aspect"},{"@id":"kg:impact"}]},{"@id":"kg:h54","@type":"kg:Clause","rdfs:label":{"@value":"5.4 근로자 협의 및 참여","@language":"ko"},"rdfs:comment":{"@value":"근로자가 안전보건 문제에 의견을 제시하고 의사결정에 참여하도록 하는 과정을 다룹니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-45001-clauses"}],"dct:identifier":"ISO 45001:2018 §5.4","kg:addresses":[{"@id":"kg:participate"}]},{"@id":"kg:h6121","@type":"kg:Clause","rdfs:label":{"@value":"6.1.2.1 유해·위험요인 식별","@language":"ko"},"rdfs:comment":{"@value":"업무 장소와 활동에서 부상 또는 건강 장해를 유발할 수 있는 원천을 찾아내는 활동을 다룹니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-45001-clauses"}],"dct:identifier":"ISO 45001:2018 §6.1.2.1","kg:addresses":[{"@id":"kg:hazard"}]},{"@id":"kg:b822","@type":"kg:Clause","rdfs:label":{"@value":"8.2.2 업무영향분석","@language":"ko"},"rdfs:comment":{"@value":"업무 중단의 영향과 그 시간적 변화를 분석하여 우선해야 할 활동을 결정하는 과정을 다룹니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/75106.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-22301-clauses"}],"dct:identifier":"ISO 22301:2019 §8.2.2","kg:addresses":[{"@id":"kg:bia"}]},{"@id":"kg:i612","@type":"kg:Clause","rdfs:label":{"@value":"6.1.2 정보보호 리스크 평가","@language":"ko"},"rdfs:comment":{"@value":"정보보호 리스크를 일관된 기준으로 식별·분석·평가하는 과정을 다룹니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27001-clauses"}],"dct:identifier":"ISO/IEC 27001:2022 §6.1.2","kg:addresses":[{"@id":"kg:isrisk"}]},{"@id":"kg:p612","@type":"kg:Clause","rdfs:label":{"@value":"6.1.2 개인정보보호 리스크 평가","@language":"ko"},"rdfs:comment":{"@value":"개인정보 처리와 관련된 리스크를 어떤 절차와 기준으로 평가할지 다룹니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27701-clauses"}],"dct:identifier":"ISO/IEC 27701:2025 §6.1.2","kg:addresses":[{"@id":"kg:privrisk"}]},{"@id":"kg:a614","@type":"kg:Clause","rdfs:label":{"@value":"6.1.4 AI 시스템 영향평가","@language":"ko"},"rdfs:comment":{"@value":"AI 시스템의 영향을 어떻게 평가할지 조직의 기획 단계에서 정하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-42001-clauses"}],"dct:identifier":"ISO/IEC 42001:2023 §6.1.4","kg:addresses":[{"@id":"kg:aia"}]},{"@id":"kg:a84","@type":"kg:Clause","rdfs:label":{"@value":"8.4 AI 시스템 영향평가","@language":"ko"},"rdfs:comment":{"@value":"기획한 영향평가를 운영 과정에서 수행하고 그 결과를 문서화하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-42001-clauses"}],"dct:identifier":"ISO/IEC 42001:2023 §8.4","kg:addresses":[{"@id":"kg:aia"}]},{"@id":"kg:d622","@type":"kg:Clause","rdfs:label":{"@value":"6.2.2 영향의 우선순위 결정","@language":"ko"},"rdfs:comment":{"@value":"조직이 지속가능발전목표에 미치는 영향을 검토하고 우선적으로 관리할 영향을 결정하는 조항입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-53001-clauses"}],"dct:identifier":"ISO/UNDP 53001:2026 §6.2.2","kg:addresses":[{"@id":"kg:priority"}]},{"@id":"kg:exEvidence","@type":"kg:Example","rdfs:label":{"@value":"수료 승인 이력","@language":"ko"},"rdfs:comment":{"@value":"교육기관의 수료 처리 표본 한 건에서 승인자와 승인 시각을 확인한 기록입니다. 적용 절차의 승인 요건과 대조할 수 있습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}]},{"@id":"kg:exCriteria","@type":"kg:Example","rdfs:label":{"@value":"수료 승인 절차","@language":"ko"},"rdfs:comment":{"@value":"가상의 교육기관은 수료증 발급 전에 교육담당자의 이수내역 승인을 받도록 내부 절차에 정했습니다. 이 심사에 적용되는 기준의 예입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}]},{"@id":"kg:exFind","@type":"kg:Example","rdfs:label":{"@value":"승인 전 수료증 발급","@language":"ko"},"rdfs:comment":{"@value":"내부 절차와 표본 한 건의 시각 기록을 대조했습니다. 수료증 발급 뒤에 승인이 이루어져 선승인 요건을 충족하지 못한 것으로 판단했습니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/19011"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}]},{"@id":"kg:exCorr","@type":"kg:Example","rdfs:label":{"@value":"누락 승인 건 보완","@language":"ko"},"rdfs:comment":{"@value":"발견한 한 건의 이수내역을 검토하고 승인 누락을 처리했습니다. 해당 건을 바로잡은 조치입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}]},{"@id":"kg:exCa","@type":"kg:Example","rdfs:label":{"@value":"승인 전 발급 차단","@language":"ko"},"rdfs:comment":{"@value":"원인 분석에서 미승인 건도 발급할 수 있는 설정을 확인했습니다. 발급 조건을 수정하고 후속 표본에서 같은 누락이 재발하는지 점검합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9000"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#audit-glossary"}]},{"@id":"kg:exEnv","@type":"kg:Example","rdfs:label":{"@value":"세척 공정의 용수 사용","@language":"ko"},"rdfs:comment":{"@value":"세척 공정이 지역의 물을 취수해 사용하는 활동은 환경측면입니다. 과다 취수로 하천 유량이 줄어드는 결과는 환경영향에 해당합니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/14001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-14001-clauses"}]},{"@id":"kg:exAi","@type":"kg:Example","rdfs:label":{"@value":"AI 채점 영향평가서","@language":"ko"},"rdfs:comment":{"@value":"가상의 교육기관이 자동 채점 도입 전 수강생 집단별 오채점 가능성을 살피고, 이의신청과 사람의 재검토 방안을 기록한 문서입니다. 조직이 선택한 기록 예시입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/42001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-42001-clauses"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#ai-management"}]},{"@id":"kg:exBia","@type":"kg:Example","rdfs:label":{"@value":"강의실 중단 영향표","@language":"ko"},"rdfs:comment":{"@value":"온라인 강의실이 2시간, 1일, 3일 중단될 때 수강·출결·수료 처리에 어떤 영향이 생기는지 비교한 가상의 분석표입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/75106.html"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-22301-clauses"}]},{"@id":"kg:exHealth","@type":"kg:Example","rdfs:label":{"@value":"현장 순회 점검기록","@language":"ko"},"rdfs:comment":{"@value":"작업자와 함께 미끄럼 위험 장소를 표시하고 원천과 노출 상황을 기록한 점검표입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/45001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-45001-clauses"}]},{"@id":"kg:exPrivacy","@type":"kg:Example","rdfs:label":{"@value":"수강기록 접근 검토","@language":"ko"},"rdfs:comment":{"@value":"수강생 출결정보를 조회하는 역할과 보유 기간을 파악해 과도한 열람·보관의 영향을 검토한 가상의 기록입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27701"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27701-clauses"}]},{"@id":"kg:exSec","@type":"kg:Example","rdfs:label":{"@value":"접근권한 평가 기록","@language":"ko"},"rdfs:comment":{"@value":"담당자 변경 뒤에도 이전 권한이 남을 가능성과 그 결과를 검토하여 대응 우선순위를 정한 가상의 기록입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/27001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-27001-clauses"}]},{"@id":"kg:exSDG","@type":"kg:Example","rdfs:label":{"@value":"교육 접근성 영향표","@language":"ko"},"rdfs:comment":{"@value":"교육과정의 접근성 개선이 학습 기회에 미치는 이익과 디지털 소외 가능성을 나란히 검토한 가상의 우선순위표입니다.","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/53001"},{"@id":"https://roknnaoms-hub.github.io/kcli-homepage/#iso-53001-clauses"}]},{"@id":"kg:statement-s9001-specifies-qms","@type":"rdf:Statement","rdf:subject":{"@id":"kg:s9001"},"rdf:predicate":{"@id":"kg:specifies"},"rdf:object":{"@id":"kg:qms"},"kg:basis":{"@value":"규격 범위","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"}]},{"@id":"kg:statement-qms-isKindOf-ms","@type":"rdf:Statement","rdf:subject":{"@id":"kg:qms"},"rdf:predicate":{"@id":"kg:isKindOf"},"rdf:object":{"@id":"kg:ms"},"kg:basis":{"@value":"교육용 개념 연결","@language":"ko"},"dct:source":[{"@id":"https://www.iso.org/standard/9001"},{"@id":"