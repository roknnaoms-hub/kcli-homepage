     "@id": "kg:finding"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exEvidence"
    }
   ]
  },
  {
   "@id": "kg:finding",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Audit findings",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "The result of comparing audit evidence with audit criteria. Recording both the requirement and the observed facts makes the finding traceable.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Audit findings",
     "@language": "en"
    }
   ],
