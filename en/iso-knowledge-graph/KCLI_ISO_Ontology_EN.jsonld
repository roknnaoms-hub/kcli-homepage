   ]
  },
  {
   "@id": "kg:sdg",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Sustainable Development Goals",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "The 17 UN Sustainable Development Goals. Organisations consider their own impacts when selecting goals and actions.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/53001"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Sustainable Development Goals",
     "@language": "en"
    },
    {
     "@value": "SDGs",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:priority",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Impact prioritization",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Reviewing the positive and negative impacts an organisation has identified to decide which to address first.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/53001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-53001-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Impact prioritization",
     "@language": "en"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exSDG"
    }
   ]
  },
  {
   "@id": "kg:cb",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Certification body",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An independent third-party body that audits an organisation’s management system and decides whether to grant certification.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/61651.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/institute/#certification-system"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Certification body",
     "@language": "en"
    }
   ],
   "kg:topic": [
    {
     "@id": "kg:cert"
    }
   ]
  },
  {
   "@id": "kg:cert",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Management system certification",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Formal third-party confirmation following an independent evaluation of a management system against specified requirements.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/61651.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/institute/#certification-system"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Management system certification",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:third",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Third-party certification audit",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An independent external audit by a certification body to inform a decision about management system certification.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/61651.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/institute/#certification-system"
    }
   ],
   "skos:altLabel": [
