   "@id": "kg:d622",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.2.2 Prioritising impacts",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns reviewing impacts on the Sustainable Development Goals and determining which impacts to manage first.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/53001"
