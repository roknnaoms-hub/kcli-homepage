  {
   "@id": "kg:criteria",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Audit criteria",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "The requirements against which the auditor compares evidence. Examples include a clause of a standard, an internal procedure or a contract requirement.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
