  {
   "@id": "kg:ai",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "AI system",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A system that processes inputs for given objectives and produces outputs such as predictions, recommendations or decisions. It is the technical subject of management and assessment.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/42001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#ai-management"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "AI system",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:aia",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "AI system impact assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An assessment of the potential consequences of developing, providing or using an AI system for people, groups and society.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/42001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-42001-clauses"
