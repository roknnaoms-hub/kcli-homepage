     "@id": "kg:conform"
    },
    {
     "@id": "kg:nc"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exFind"
    }
   ]
  },
  {
   "@id": "kg:audit",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Audit",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A systematic, independent examination of evidence within an agreed scope to determine how far the audit criteria are met.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Audit",
     "@language": "en"
    }
   ],
   "kg:topic": [
    {
     "@id": "kg:criteria"
    },
    {
     "@id": "kg:evidence"
    }
   ]
  },
  {
   "@id": "kg:auditor",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Auditor",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A person who conducts an audit, gathers evidence and applies relevant requirements and audit methods to evaluate it.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Auditor",
     "@language": "en"
    }
   ],
   "kg:topic": [
    {
     "@id": "kg:audit"
    }
   ]
  },
  {
   "@id": "kg:internal",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Internal audit",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An audit of the organisation’s management system carried out by the organisation or on its behalf against specified criteria.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Internal audit",
     "@language": "en"
    }
   ],
   "kg:isKindOf": [
    {
     "@id": "kg:audit"
    }
   ]
  },
  {
   "@id": "kg:programme",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Audit programme",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Arrangements for managing one or more audits over a period to achieve stated objectives.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Audit programme",
     "@language": "en"
    }
   ],
   "kg:topic": [
    {
     "@id": "kg:audit"
    }
   ]
  },
  {
   "@id": "kg:req",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Requirement",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A need or expectation that a product, service, process or management system must meet.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Requirement",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:conform",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Conformity",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "The condition in which the item being examined meets an applicable requirement.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Conformity",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:nc",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Nonconformity",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Failure to meet an applicable requirement. The auditor must be able to identify which requirement the evidence shows was unmet.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Nonconformity",
     "@language": "en"
    }
   ],
   "kg:mayTrigger": [
    {
     "@id": "kg:correction"
    },
    {
     "@id": "kg:ca"
    }
   ]
  },
  {
   "@id": "kg:correction",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Correction",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Action that fixes the detected nonconformity. For example, a training provider might review and complete a missing approval in an individual record.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Correction",
     "@language": "en"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exCorr"
    }
   ]
  },
  {
   "@id": "kg:ca",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Corrective action",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Action aimed at removing the cause of a nonconformity to prevent recurrence. The organisation checks that the action has been effective.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Corrective action",
     "@language": "en"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exCa"
    }
   ]
  },
  {
   "@id": "kg:process",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Process",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Related activities that use inputs to produce an intended result.",
    "@language": "en"
   },
   "dct:source": [
