     "@id": "kg:exCriteria"
    }
   ]
  },
  {
   "@id": "kg:evidence",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Audit evidence",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Verifiable information relevant to the audit criteria. This may include records, observations and statements that can be checked.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
