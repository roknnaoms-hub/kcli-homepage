     "@id": "kg:nc"
    },
    {
     "@id": "kg:correction"
    },
    {
     "@id": "kg:ca"
    }
   ]
  },
  {
   "@id": "kg:e612",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.1.2 Environmental aspects",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns identifying environmental aspects of activities, products and services, their associated impacts and their significance.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/14001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-14001-clauses"
    }
   ],
   "dct:identifier": "ISO 14001:2026 §6.1.2",
   "kg:addresses": [
    {
     "@id": "kg:aspect"
    },
    {
     "@id": "kg:impact"
    }
   ]
  },
  {
   "@id": "kg:h54",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "5.4 Consultation and participation of workers",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns enabling workers to give their views and participate in decisions on occupational health and safety.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/45001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-45001-clauses"
    }
   ],
   "dct:identifier": "ISO 45001:2018 §5.4",
   "kg:addresses": [
    {
     "@id": "kg:participate"
    }
   ]
  },
  {
   "@id": "kg:h6121",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.1.2.1 Hazard identification",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns identifying sources of potential injury or ill health in work activities and workplaces.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/45001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-45001-clauses"
    }
   ],
   "dct:identifier": "ISO 45001:2018 §6.1.2.1",
   "kg:addresses": [
