    }
   ]
  },
  {
   "@id": "kg:b822",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "8.2.2 Business impact analysis",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns analysing the impacts of disruption over time to identify priority activities.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/75106.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-22301-clauses"
    }
   ],
   "dct:identifier": "ISO 22301:2019 §8.2.2",
   "kg:addresses": [
    {
     "@id": "kg:bia"
    }
   ]
  },
  {
   "@id": "kg:i612",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.1.2 Information security risk assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns identifying, analysing and evaluating information security risks against consistent criteria.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27001-clauses"
    }
   ],
   "dct:identifier": "ISO/IEC 27001:2022 §6.1.2",
   "kg:addresses": [
    {
     "@id": "kg:isrisk"
    }
   ]
  },
  {
   "@id": "kg:p612",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.1.2 Privacy risk assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns the process and criteria an organisation uses to assess privacy risks in personal information processing.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27701"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27701-clauses"
    }
   ],
   "dct:identifier": "ISO/IEC 27701:2025 §6.1.2",
   "kg:addresses": [
    {
     "@id": "kg:privrisk"
    }
   ]
  },
  {
   "@id": "kg:a614",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "6.1.4 AI system impact assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns planning how the organisation will assess the impacts of its AI systems.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/42001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-42001-clauses"
    }
   ],
   "dct:identifier": "ISO/IEC 42001:2023 §6.1.4",
   "kg:addresses": [
