     "@value": "Personally identifiable information",
     "@language": "en"
    },
    {
     "@value": "PII",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:privrisk",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Privacy risk assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Identifying and evaluating risks arising from the processing of personally identifiable information.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27701"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27701-clauses"
