     "@id": "kg:exSec"
    }
   ]
  },
  {
   "@id": "kg:pii",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Personally identifiable information",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Information linked to an individual, or information that can identify an individual when combined with other data.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27701"
    }
   ],
   "skos:altLabel": [
