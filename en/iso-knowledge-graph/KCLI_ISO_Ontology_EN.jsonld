  {
   "@id": "kg:exEvidence",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Completion approval log",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A sample course completion record shows who approved the completion and when. An auditor can compare it with the applicable approval procedure.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ]
  },
  {
   "@id": "kg:exCriteria",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Completion approval procedure",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A training provider requires an authorised staff member to approve completion before a certificate is issued. The procedure provides an audit criterion.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ]
  },
  {
   "@id": "kg:exFind",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Certificate issued before approval",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An auditor compares the procedure with one record and finds that the certificate was issued before approval, contrary to the prior-approval requirement.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/19011"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ]
  },
  {
   "@id": "kg:exCorr",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Correcting a missing approval",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Staff review the affected completion record and address the missing approval for that particular case.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ]
  },
  {
   "@id": "kg:exCa",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Blocking unapproved certificates",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A review finds that the system allows certificates to be issued before approval. Staff change the release condition and check subsequent samples for recurrence.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ]
  },
  {
   "@id": "kg:exEnv",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Water used in cleaning",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A cleaning process draws local water. The water use is an aspect. A reduction in river flow caused by excessive withdrawal is an impact.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/14001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-14001-clauses"
    }
   ]
  },
  {
   "@id": "kg:exAi",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "AI marking impact report",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Before introducing automated marking, a training provider assesses the risk of inaccurate scores across learner groups and records how appeals and human reviews will work.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/42001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-42001-clauses"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#ai-management"
    }
   ]
  },
  {
   "@id": "kg:exBia",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Classroom outage impacts",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An example analysis compares the effects of a two-hour, one-day and three-day classroom outage on learning, attendance and completion records.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/75106.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-22301-clauses"
    }
   ]
  },
  {
   "@id": "kg:exHealth",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Workplace inspection record",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Workers and an inspector mark slip hazards on a site walk and record the sources of the hazards and how workers could be exposed.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/45001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-45001-clauses"
    }
   ]
  },
  {
   "@id": "kg:exPrivacy",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Review of access to attendance records",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A review identifies who can view learner attendance records and how long the records are kept, then examines the impact of excessive access or retention.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27701"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27701-clauses"
    }
   ]
  },
  {
   "@id": "kg:exSec",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Access permissions assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An assessment reviews the likelihood and consequences of staff retaining permissions after a change of role and prioritises a response.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27001-clauses"
    }
   ]
  },
  {
   "@id": "kg:exSDG",
   "@type": "kg:Example",
   "rdfs:label": {
    "@value": "Learning access impact matrix",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An example prioritisation record weighs the benefits of widening access to courses against the possibility of excluding learners with limited digital access.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/53001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-53001-clauses"
    }
   ]
  },
