  {
   "@id": "kg:q92",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "9.2 Internal audit",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Uses planned internal audits to check whether the quality management system meets applicable requirements and operates effectively.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-9001-clauses"
    }
   ],
   "dct:identifier": "ISO 9001:2026 §9.2",
   "kg:addresses": [
    {
     "@id": "kg:internal"
    }
   ]
  },
  {
   "@id": "kg:q102",
   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "10.2 Nonconformity and corrective action",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Covers responding to nonconformity, considering the need to address causes and checking the effectiveness of corrective action.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-9001-clauses"
    }
   ],
   "dct:identifier": "ISO 9001:2026 §10.2",
   "kg:addresses": [
