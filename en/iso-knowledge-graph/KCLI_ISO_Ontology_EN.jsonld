     "@value": "Process",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:party",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Interested party",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A person or organisation that can affect, be affected by, or perceive itself to be affected by a decision or activity.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/9000"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/audit-practice/#audit-glossary"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Interested party",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:aspect",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Environmental aspect",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An element of an organisation’s activities, products or services that interacts with the environment. Water use in cleaning is one example.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/14001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-14001-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Environmental aspect",
     "@language": "en"
    }
   ],
   "kg:mayCause": [
    {
     "@id": "kg:impact"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exEnv"
    }
   ]
  },
  {
   "@id": "kg:impact",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Environmental impact",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A change to the environment arising from an environmental aspect. Changes in available water resources can be beneficial or adverse.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/14001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-14001-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Environmental impact",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:hazard",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Hazard",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A source of potential injury or ill health. For example, water left in a walkway can cause a slip.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/45001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-45001-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Hazard",
     "@language": "en"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exHealth"
    }
   ]
  },
  {
   "@id": "kg:participate",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Participation of workers",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Workers’ involvement in decisions about health and safety in their workplace.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/45001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-45001-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Participation of workers",
     "@language": "en"
    }
   ]
  },
  {
   "@id": "kg:bia",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Business impact analysis",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "An analysis of how the effects of a disruption change over time, used to determine recovery priorities and resources.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/75106.html"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-22301-clauses"
    }
   ],
   "skos:altLabel": [
    {
     "@value": "Business impact analysis",
     "@language": "en"
    },
    {
     "@value": "BIA",
     "@language": "en"
    }
   ],
   "kg:example": [
    {
     "@id": "kg:exBia"
    }
   ]
  },
  {
   "@id": "kg:isrisk",
   "@type": "kg:Term",
   "rdfs:label": {
    "@value": "Information security risk assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Identifying, analysing and evaluating threats to information confidentiality, integrity and availability to determine response priorities.",
    "@language": "en"
   },
   "dct:source": [
    {
     "@id": "https://www.iso.org/standard/27001"
    },
    {
     "@id": "https://roknnaoms-hub.github.io/kcli-homepage/en/clauses/#iso-27001-clauses"
    }
   ],
   "skos:altLabel": [
