   "@type": "kg:Clause",
   "rdfs:label": {
    "@value": "8.4 AI system impact assessment",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "Concerns carrying out the planned AI system impact assessment and documenting its results.",
    "@language": "en"
   },
   "dct:source": [
